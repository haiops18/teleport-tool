MYSQL_DATABASE=teleport_scanner
MYSQL_USER=teleport_scanner
MYSQL_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
MYSQL_ROOT_PASSWORD=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_VALUE
DATABASE_URL=mysql+pymysql://teleport_scanner:CHANGE_ME_TO_A_LONG_RANDOM_VALUE@mysql:3306/teleport_scanner
APP_SECRET=CHANGE_ME_TO_A_64_CHARACTER_RANDOM_VALUE
SESSION_TTL_HOURS=12
SCAN_CONCURRENCY=10
SCAN_BATCH_SIZE=10
SCAN_MAX_NODES_PER_REQUEST=500
DISCOVERY_MAX_CONCURRENCY=20
DISCOVERY_BATCH_SIZE=20
DISCOVERY_MAX_NODES_PER_REQUEST=1800
DISCOVERY_SCAN_TIMEOUT_SECONDS=60
SERVICE_CONFIG_MAX_CONCURRENCY=5
SERVICE_CONFIG_BATCH_SIZE=10
SERVICE_CONFIG_MAX_NODES_PER_REQUEST=100
TELEPORT_RESTART_MAX_CONCURRENCY=2
TELEPORT_RESTART_RETRY_INTERVAL=5
TELEPORT_RESTART_MAX_WAIT=120
SSH_TIMEOUT_SECONDS=30
SCAN_TIMEOUT_SECONDS=60
ALLOWED_ORIGINS=http://localhost
ADMIN_USERS=admin@example.com
OPERATOR_USERS=operator@example.com
DEFAULT_ROLE=VIEWER
# For TLS deployments use nginx/nginx.https.conf.template after rendering
# SERVER_NAME, TLS_CERT_PATH and TLS_KEY_PATH from your secret manager.
SERVER_NAME=scanner.example.invalid
TLS_CERT_PATH=/run/secrets/tls.crt
TLS_KEY_PATH=/run/secrets/tls.key
