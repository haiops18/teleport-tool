# Production TLS template. Render with envsubst or your secret-management
# system, then mount it as /etc/nginx/conf.d/default.conf. Keep the current
# nginx.conf for development, RC, or deployments where an upstream LB
# terminates TLS.
server {
  listen 80;
  server_name ${SERVER_NAME};
  return 301 https://$host$request_uri;
}
server {
  listen 443 ssl http2;
  server_name ${SERVER_NAME};
  ssl_certificate ${TLS_CERT_PATH};
  ssl_certificate_key ${TLS_KEY_PATH};
  ssl_protocols TLSv1.2 TLSv1.3;
  client_max_body_size 2m;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy same-origin always;
  location /api/ {
    proxy_pass http://backend:8000/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 15s;
    proxy_send_timeout 180s;
    proxy_read_timeout 180s;
  }
  location /health { proxy_pass http://backend:8000/health; }
  location / { proxy_pass http://frontend:8080/; proxy_set_header Host $host; }
}
